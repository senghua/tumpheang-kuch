---
import BaseLayout from "../layouts/BaseLayout.astro";
import Bilingual from "../components/Bilingual.astro";
import Eyebrow from "../components/Eyebrow.astro";
import Button from "../components/Button.astro";
import { useBilingual } from "../i18n/utils";

const tt = useBilingual(Astro.currentLocale);
const title = tt("notFound.title");
const subtitle = tt("notFound.subtitle");
const eyebrow = tt("notFound.eyebrow");
const back = tt("notFound.back");
---

<BaseLayout title="Page Not Found — Tum Pheang Kuch">
  <section class="flex min-h-[70vh] flex-col items-center justify-center px-4 text-center">
    <Eyebrow km={eyebrow.km} en={eyebrow.en} />
    <h1 class="mt-3 font-khmer text-3xl font-bold text-brand-charcoal sm:text-4xl">
      {title.km}
    </h1>
    <p class="mt-2 text-sm font-medium text-brand-charcoal/50">{title.en}</p>
    <p class="mt-4 text-base text-brand-charcoal/80">{subtitle.km}</p>
    <p class="mt-1 text-sm text-brand-charcoal/55">{subtitle.en}</p>
    <Button href="/" variant="solid" class="mt-8">
      <Bilingual km={back.km} en={back.en} enClass="opacity-80" />
    </Button>
  </section>
</BaseLayout>
