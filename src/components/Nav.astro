---
import Logo from "./Logo.astro";
import Bilingual from "./Bilingual.astro";
import { useBilingual } from "../i18n/utils";

const tt = useBilingual(Astro.currentLocale);
const openMenuLabel = tt("nav.openMenu").km;

const links = [
  { href: "#about", ...tt("nav.about") },
  { href: "#vision", ...tt("nav.vision") },
  { href: "#leadership", ...tt("nav.leadership") },
  { href: "#membership", ...tt("nav.membership") },
  { href: "#activities", ...tt("nav.activities") },
  { href: "#speakers", ...tt("nav.speakers") },
  { href: "#partners", ...tt("nav.partners") },
  { href: "#contact", ...tt("nav.contact") },
];
---

<header id="site-header" class="sticky top-0 z-50 border-b border-transparent bg-white transition-colors" data-nav>
  <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3 sm:px-6 lg:px-8">
    <a href="#hero" class="shrink-0">
      <Logo />
    </a>

    <nav class="hidden min-[1120px]:block">
      <ul class="flex flex-wrap items-center gap-4 text-sm font-medium text-brand-charcoal 2xl:gap-6">
        {
          links.map((link) => (
            <li>
              <a href={link.href} class="whitespace-nowrap underline-offset-4 transition-colors hover:underline hover:decoration-brand-red">
                <Bilingual km={link.km} en={link.en} />
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <button
        id="nav-toggle"
        type="button"
        class="relative z-[60] flex h-10 w-10 items-center justify-center text-brand-charcoal transition-colors min-[1120px]:hidden"
        aria-label={openMenuLabel}
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span id="nav-icon" class="material-symbols-outlined" aria-hidden="true">menu</span>
      </button>
    </div>
  </div>

  <nav id="mobile-menu" class="fixed inset-0 z-50 hidden bg-brand-charcoal text-white min-[1120px]:hidden">
    <ul class="flex h-full flex-col items-center justify-center gap-6 text-2xl font-semibold">
      {
        links.map((link) => (
          <li>
            <a href={link.href} class="underline-offset-4 transition-colors hover:underline hover:decoration-brand-red">
              <Bilingual km={link.km} en={link.en} enClass="opacity-50" />
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  const header = document.getElementById("site-header");
  const onScroll = () => {
    if (!header) return;
    header.classList.toggle("border-black/10", window.scrollY > 8);
  };
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });

  const toggle = document.getElementById("nav-toggle");
  const menu = document.getElementById("mobile-menu");
  const navIcon = document.getElementById("nav-icon");

  const setOpen = (isOpen: boolean) => {
    menu?.classList.toggle("hidden", !isOpen);
    toggle?.setAttribute("aria-expanded", String(isOpen));
    if (navIcon) navIcon.textContent = isOpen ? "close" : "menu";
    toggle?.classList.toggle("text-white", isOpen);
    toggle?.classList.toggle("text-brand-charcoal", !isOpen);
  };

  toggle?.addEventListener("click", () => {
    setOpen(menu?.classList.contains("hidden") === true);
  });

  menu?.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => setOpen(false)));
</script>
