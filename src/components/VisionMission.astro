---
import Bilingual from "./Bilingual.astro";
import Eyebrow from "./Eyebrow.astro";
import { useBilingual } from "../i18n/utils";

const tt = useBilingual(Astro.currentLocale);
const visionTitle = tt("vision.title");
const visionDescription = tt("vision.description");
const visionEyebrow = tt("vision.eyebrow");
const missionEyebrow = tt("mission.eyebrow");
const coValueEyebrow = tt("coValue.eyebrow");

const missionStats = [
  { value: "10,000", count: 10000, km: "យុវជនទំពាំងគជ់ក្នុងរយៈពេល១០ឆ្នាំ", en: "Tum Pheang Kuch youth within 10 years" },
  { value: "1,000", count: 1000, km: "ឱកាសការងារជូនយុវជនក្នុងមួយឆ្នាំ", en: "job opportunities for youth per year" },
  { value: "1,000", count: 1000, km: "អ្នកដឹកនាំវ័យក្មេងក្នុងមួយឆ្នាំ", en: "young leaders developed per year" },
];

const coValueKeys = ["coValue.item1", "coValue.item2", "coValue.item3", "coValue.item4", "coValue.item5"] as const;
const coValues = coValueKeys.map((key) => tt(key));
---

<section id="vision" class="scroll-mt-20 bg-neutral-50 py-24 sm:py-32">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="grid gap-16 lg:grid-cols-12 lg:gap-12">
      <div class="lg:col-span-5" data-reveal>
        <Eyebrow km={visionEyebrow.km} en={visionEyebrow.en} />
        <h2 class="mt-4 font-khmer text-3xl leading-snug font-bold tracking-tight text-brand-charcoal sm:text-4xl">
          {visionTitle.km}
        </h2>
        <p class="mt-2 text-sm font-medium text-brand-charcoal/55">
          {visionTitle.en}
        </p>
        <p class="mt-8 text-base leading-relaxed text-brand-charcoal/80">
          {visionDescription.km}
        </p>
        <p class="mt-3 text-sm leading-relaxed text-brand-charcoal/55">
          {visionDescription.en}
        </p>
      </div>

      <div class="lg:col-span-7" data-reveal style="transition-delay: 100ms">
        <Eyebrow km={missionEyebrow.km} en={missionEyebrow.en} />
        <div class="mt-8 grid gap-4 sm:grid-cols-3">
          {
            missionStats.map((stat) => (
              <div class="border border-black/10 bg-white p-6 transition-colors hover:border-brand-charcoal/30">
                <p class="font-khmer text-4xl leading-snug font-extrabold tracking-tight text-brand-gold">
                  <span data-count-to={stat.count}>{stat.value}</span>
                </p>
                <p class="mt-3 font-khmer text-sm leading-snug font-medium text-brand-charcoal">{stat.km}</p>
                <p class="mt-1 text-xs leading-relaxed text-brand-charcoal/55">{stat.en}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>

    <div class="mt-20 border-t border-black/10 pt-16" data-reveal>
      <Eyebrow km={coValueEyebrow.km} en={coValueEyebrow.en} />
      <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          coValues.map((value, i) => (
            <li
              class="flex flex-col gap-3 border border-black/10 bg-white p-6 transition-colors hover:border-brand-charcoal/30"
              data-reveal
              style={`transition-delay: ${i * 90}ms`}
            >
              <span class="font-mono text-xs text-brand-charcoal/40">0{i + 1}</span>
              <span class="text-sm leading-relaxed text-brand-charcoal/80">
                <Bilingual km={value.km} en={value.en} />
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
