---
import { Image } from "astro:assets";
import huongSokEn from "../assets/founders/ms-huong-sok-en.jpg";
import thornRivong from "../assets/founders/mr-thorn-rivong.jpg";
import Bilingual from "./Bilingual.astro";
import Eyebrow from "./Eyebrow.astro";
import { useBilingual } from "../i18n/utils";

const tt = useBilingual(Astro.currentLocale);
const title = tt("about.title");
const description = tt("about.description");
const eyebrow = tt("about.eyebrow");
const founderRole = tt("about.founderRole");

const founders = [
  { km: "អ្នកនាង ហួង សុខអិន", en: "Ms. Huong Sok En", photo: huongSokEn },
  { km: "លោក ថន រីវង្ស", en: "Mr. Thorn Rivong", photo: thornRivong },
];
---

<section id="about" class="scroll-mt-20 bg-white py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-3xl text-center" data-reveal>
      <div class="flex justify-center">
        <Eyebrow km={eyebrow.km} en={eyebrow.en} />
      </div>
      <h2 class="mt-3 font-khmer text-3xl leading-snug font-bold tracking-tight text-brand-charcoal sm:text-4xl">
        {title.km}
      </h2>
      <p class="mt-2 text-sm font-medium text-brand-charcoal/55 sm:text-base">
        {title.en}
      </p>
      <p class="mt-6 text-base leading-relaxed text-brand-charcoal/80 sm:text-lg">
        {description.km}
      </p>
      <p class="mt-3 text-sm leading-relaxed text-brand-charcoal/55 sm:text-base">
        {description.en}
      </p>
    </div>

    <div class="mt-16 grid gap-6 sm:grid-cols-2 sm:gap-8">
      {
        founders.map((f, i) => (
          <div
            class="flex flex-col items-center border border-black/10 p-8 text-center transition-colors hover:border-brand-charcoal/30"
            data-reveal
            style={`transition-delay: ${i * 100}ms`}
          >
            <Image
              src={f.photo}
              alt={f.en}
              width={112}
              height={112}
              densities={[1, 1.5, 2, 3]}
              quality={90}
              class="h-28 w-28 object-cover"
            />
            <h3 class="mt-5 font-khmer text-xl leading-snug font-bold text-brand-charcoal">{f.km}</h3>
            <p class="text-sm text-brand-charcoal/55">{f.en}</p>
            <p class="mt-2 text-sm font-semibold text-brand-charcoal">
              <Bilingual km={founderRole.km} en={founderRole.en} />
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>
